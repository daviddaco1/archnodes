{
  "name": "project-visualizer",
  "version": "0.1.0",
  "description": "Editor visual de arquitectura (backend/frontend) con servidor MCP para agentes de IA",
  "type": "module",
  "bin": {
    "project-visualizer": "dist/cli.js"
  },
  "files": [
    "dist",
    "client/dist",
    "skills"
  ],
  "engines": {
    "node": ">=18.3.0"
  },
  "workspaces": [
    "client",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@project-visualizer/shared && tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:client": "npm test --workspace=client",
    "perf": "node dist/perf/bench.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@project-visualizer/shared": "*",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
